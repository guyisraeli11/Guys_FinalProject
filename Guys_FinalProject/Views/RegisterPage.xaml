<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Guys_FinalProject.Views.RegisterPage"
             Title="RegisterPage">
    <ScrollView>
        <VerticalStackLayout
         Padding="25"
         Spacing="8"
         HorizontalOptions="Center"
         VerticalOptions="Center"
         MaximumWidthRequest="500">

            <Label Text="Sign up"
                FontSize="26"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />

            <Label Text="Enter your Full Name"
                HorizontalOptions="Center" />

            <Entry x:Name="FullNameEntry"
                Placeholder="Full Name"
                WidthRequest="300" />

            <Label Text="Enter your UserName"
                HorizontalOptions="Center" />

            <Entry x:Name="UsernameEntry"
                Placeholder="Username"
                WidthRequest="300" />

            <Label Text="Enter your E-mail"
                HorizontalOptions="Center" />

            <Entry x:Name="EmailEntry"
                Placeholder="E-mail"
                Keyboard="Email"
                Style="{StaticResource entryForm}" />

            <Label Text="Enter your E-mail Password"
                HorizontalOptions="Center" />

            <Entry x:Name="PasswordEntry"
                Placeholder="Password"
                IsPassword="True"
                Style="{StaticResource entryForm}" />

            <Label Text="RE-enter your E-mail Password"
                HorizontalOptions="Center" />

            <Entry x:Name="ConfirmPasswordEntry"
                Placeholder="Re-enter password"
                IsPassword="True"
                Style="{StaticResource entryForm}" />

            <Label x:Name="MessageLabel"
                TextColor="{StaticResource labelError}"
                HorizontalTextAlignment="Center" />

            <Button Text="Sign Up"  Style="{StaticResource LoginRegisterButton}"  HorizontalOptions="Center" Clicked="OnSignUpClicked" />
            
            <Button Text="Already have an account?  Login" Style="{StaticResource ButtonTransparent}" Clicked="OnGoToLoginClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>